# Account Intelligence Radar — Environment Variables
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control.

# --- Discovery Layer ---
SERPAPI_KEY="YOU API KEY"

# --- Decision Layer (DeepSeek primary, OpenAI fallback) ---
DEEPSEEK_API_KEY="YOU API KEY"
OPENAI_API_KEY="YOU API KEY"  # optional fallback

# --- Extraction Layer ---
FIRECRAWL_API_KEY="YOU API KEY"

# --- Application Security & Persistence ---
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
SESSION_DAYS=14
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional. Defaults to backend/data/radar.db.
# RADAR_DB_PATH=C:\absolute\path\to\radar.db
